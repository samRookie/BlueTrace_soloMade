{
  "name": "sih26019-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "National Land Governance Research & Policy Innovation Platform — Foundation Monorepo",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "test": "vitest run",
    "db:migrate": "pnpm --filter @sih26019/db db:migrate",
    "db:migrate:status": "pnpm --filter @sih26019/db db:migrate:status",
    "db:seed": "pnpm --filter @sih26019/db db:seed",
    "db:reset": "pnpm --filter @sih26019/db db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.1",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.0.4"
  }
}
