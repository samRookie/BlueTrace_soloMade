{
  "name": "@sih26019/db",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Database configuration, schema, and migration tooling for SIH26019",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "db:migrate": "tsx ../scripts/migrate.ts",
    "db:migrate:status": "tsx ../scripts/migrate-status.ts",
    "db:seed": "tsx ./seeds/index.ts"
  },
  "dependencies": {
    "@sih26019/config": "workspace:*",
    "drizzle-orm": "^0.38.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
